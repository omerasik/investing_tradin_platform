# Trade Platform - Local Development Environment Configuration
# Copy this file to .env for custom local settings.
# All defaults below are pre-configured for safe local research / paper-only mode.

# Backend Operator Credential (Server-side only; never exposed to browser)
TRADE_PLATFORM_OPERATOR_TOKEN=local-dev-operator-token

# Dashboard Login Credential (Password used to log in at http://localhost:3000/login)
TRADE_PLATFORM_DASHBOARD_VIEW_TOKEN=local-dev-view-password

# Session Signing Secret (Used to sign HMAC-SHA256 browser session cookies)
# In local development, defaults to a secret derived from the view token if unset.
TRADE_PLATFORM_SESSION_SECRET=local-dev-session-secret-change-in-production

# Backend Service Configuration
TRADE_PLATFORM_API_BASE_URL=http://127.0.0.1:8000
API_PORT=8000

# Frontend Dashboard Configuration
TRADE_PLATFORM_DASHBOARD_ORIGIN=http://127.0.0.1:3000
PORT=3000

# Local PostgreSQL Configuration (Docker Compose on compose.dev.yml)
POSTGRES_PORT=5439
POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5439/trade_platform # pragma: allowlist secret
