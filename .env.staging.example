# Copy to `.env` (gitignored) next to docker-compose.staging.yml and fill in real
# values before running `docker compose -f docker-compose.staging.yml up`. Never commit
# a filled-in copy of this file. Every value on its own line, no inline comments after
# `=` -- Docker Compose env files do not strip trailing comments from a value.

# --- PostgreSQL ---
POSTGRES_USER=postgres
# Required -- generate a real secret, do not use a placeholder.
POSTGRES_PASSWORD=

# --- FastAPI research API (trade_platform.runtime_app) ---
# "paper" is the safe staging default. See docs/MODULE_3D_PRODUCTION_IDENTITY_SECRETS_AUDIT.md
# before ever setting this to "production" -- it requires the five TRADE_PLATFORM_OIDC_*
# / TRADE_PLATFORM_IDENTITY_POLICY_NAME / TRADE_PLATFORM_SECRETS_DIR settings below and
# an already-approved identity mapping policy, or the api/worker containers will not start.
TRADE_PLATFORM_ENVIRONMENT=paper
# Required for paper mode.
TRADE_PLATFORM_OPERATOR_TOKEN=
TRADE_PLATFORM_OPERATOR_ROLE=viewer

# production mode only -- leave blank for paper:
TRADE_PLATFORM_OIDC_ISSUER=
TRADE_PLATFORM_OIDC_AUDIENCE=
TRADE_PLATFORM_OIDC_JWKS_URL=
TRADE_PLATFORM_IDENTITY_POLICY_NAME=
# Host directory FileSecretProvider reads from (must contain CSRF_SIGNING_KEY at minimum,
# 0600-permissioned); mounted read-only into the api container at /run/secrets/trade-platform.
TRADE_PLATFORM_SECRETS_DIR_HOST=./secrets/empty

# --- Scheduler/worker (trade_platform.worker_app) ---
TRADE_PLATFORM_WORKER_POLL_SECONDS=30

# --- Next.js dashboard ---
# Required -- separate from the operator token.
TRADE_PLATFORM_DASHBOARD_VIEW_TOKEN=
# Required -- signs the dashboard's own session cookie.
TRADE_PLATFORM_SESSION_SECRET=

# --- Ports (host side; defaults shown) ---
API_PORT=8000
WORKER_PORT=8001
WEB_PORT=3000

# --- Image tag (defaults to "staging") ---
IMAGE_TAG=staging
