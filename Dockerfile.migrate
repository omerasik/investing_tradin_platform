# syntax=docker/dockerfile:1.7
#
# Disposable migration image (Module 3E) -- runs exactly one command,
# `alembic upgrade head`, against POSTGRES_DSN as an explicit, separate deployment
# step before `api`/`worker` start. Deliberately not the same image as the hardened
# research API (Dockerfile): that artifact intentionally does not bundle alembic/
# sqlalchemy (see requirements-runtime.txt), so migrations can never accidentally run
# as a side effect of starting the API or worker process.

FROM python:3.12.14-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src

RUN groupadd --gid 10001 tradeplatform \
    && useradd --uid 10001 --gid 10001 --no-log-init --home-dir /app \
        --shell /usr/sbin/nologin tradeplatform

COPY requirements-migrate.txt /tmp/requirements-migrate.txt
RUN python -m pip install --no-deps --requirement /tmp/requirements-migrate.txt \
    && python -m pip check \
    && rm /tmp/requirements-migrate.txt

WORKDIR /app
COPY --chown=10001:10001 alembic.ini ./alembic.ini
COPY --chown=10001:10001 migrations ./migrations
# Several migration scripts import DDL/table-name constants from trade_platform
# modules (e.g. postgres_schema.py) to keep a table's shape defined exactly once --
# so the full src tree comes along, not just alembic.ini/migrations.
COPY --chown=10001:10001 src ./src

USER 10001:10001

CMD ["python", "-m", "alembic", "upgrade", "head"]
