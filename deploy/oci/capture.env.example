# /etc/trade-capture/capture.env (root:trade-capture 0640). No secrets belong here.
#
# STAGE decides which roots the recorders write. "validation" roots are a
# parallel trial beside the Windows recorders and are never merged into, backed
# up into, or reported as the authoritative archive. Switch to the "archive"
# roots only at an owner-authorized cutover (README.md, "Cutover").
R0_ROOT=/srv/trade-capture/validation/capture
U2_ROOT=/srv/trade-capture/validation/capture-universe-r1b
#R0_ROOT=/srv/trade-capture/archive/capture
#U2_ROOT=/srv/trade-capture/archive/capture-universe-r1b

# Engineering safety floor (scripts/capture_bybit_public.py DEFAULT_MIN_FREE_GIB):
# below it every lane stops with DISK_BUDGET_STOP and the unit stays failed.
MIN_FREE_GB=20
