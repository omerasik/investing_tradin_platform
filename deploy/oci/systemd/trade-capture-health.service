# Read-only health snapshot of both recorders into the journal:
#   journalctl -u trade-capture-health --since -2h
[Unit]
Description=trade-platform capture recorder health snapshot
RequiresMountsFor=/srv/trade-capture

[Service]
Type=oneshot
User=trade-capture
Group=trade-capture
EnvironmentFile=/etc/trade-capture/capture.env
ExecStart=/opt/trade-capture/current/deploy/oci/trade-capture-health.sh
# The lock probe opens the existing lock file; it never takes the lock from a recorder.
ReadWritePaths=/srv/trade-capture
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
