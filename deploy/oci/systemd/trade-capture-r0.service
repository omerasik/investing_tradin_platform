# R0: BTCUSDT production contract v1, hourly bounded segments on the UTC grid.
# Public market data only: no credential, no account, no order, no broker.
#
# Exit codes (scripts/capture_bybit_public.py):
#   0  operator interrupt (systemctl stop sends SIGINT -> OPERATOR_INTERRUPT)
#   2  EXIT_DISK_FLOOR: free space below the floor -- never restarted
#   4  EXIT_ALREADY_RUNNING: another recorder holds this root -- never restarted
# Anything else (crash, OOM kill, signal) is restarted as a NEW session; the
# hole between sessions stays an explicit, unbridged gap.

[Unit]
Description=trade-platform R0 BTCUSDT public capture recorder
Documentation=file:///opt/trade-capture/current/deploy/oci/README.md
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
RequiresMountsFor=/srv/trade-capture
AssertPathIsMountPoint=/srv/trade-capture
StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
Type=simple
User=trade-capture
Group=trade-capture
EnvironmentFile=/etc/trade-capture/capture.env
WorkingDirectory=/srv/trade-capture
ExecStart=/usr/bin/python3 -I -B -u /opt/trade-capture/current/scripts/capture_bybit_public.py --root ${R0_ROOT} supervise --segment-seconds 3600 --min-free-gb ${MIN_FREE_GB}
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=2 4
KillSignal=SIGINT
TimeoutStopSec=180
UMask=0027
MemoryMax=1G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/trade-capture
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
