# Local runtimes and generated build output
.venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.next/
**/.next/
node_modules/

# Re-creatable local analysis and browser-test artifacts
tmp/
graphify-out/
web/test-results/
web/playwright-report/

# Deployment secrets and local dashboard configuration
.env
.env.*
!.env.example
!.env.staging.example
secrets/*
!secrets/empty/
!secrets/empty/.gitkeep
!secrets/README.md
web/dashboard.config.json
web/dashboard.e2e.token
*.local.json
*.token
*.credentials.json

# Local database files (SQLite is the local/dev persistence backend)
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal

# Playwright artifacts (may capture session cookies/tokens from local runs)
web/test-results/
web/playwright-report/
test-results/
playwright-report/
